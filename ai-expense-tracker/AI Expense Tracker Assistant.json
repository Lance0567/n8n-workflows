    {
      "parameters": {
        "jsCode": "const aiResponse = $input.item.json.output;\n\nfunction extractJSON(text) {\n    try {\n        const arrayMatch = text.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\n        if (arrayMatch) return JSON.parse(arrayMatch[0]);\n        const objectMatch = text.match(/\\{[\\s\\S]*\\}/);\n        if (objectMatch) return JSON.parse(objectMatch[0]);\n        return null;\n    } catch (e) { \n        throw new Error(\"Expected JSON but got invalid format.\"); \n    }\n}\n\nlet parsed = extractJSON(aiResponse);\nlet results = Array.isArray(parsed) ? parsed : [parsed];\n\nreturn results.map(data => {\n    let year = data.year;\n    if (!year && data.date) {\n        const parts = data.date.split('/');\n        if (parts.length === 3) year = parts[2];\n    }\n    if (!year) year = new Date().getFullYear().toString();\n\n    const sanitize = (text) => {\n        if (!text) return \"\";\n        return text.toString()\n            .replace(/^DATE:.*$/gm, '')    \n            .replace(/^TIME:.*$/gm, '')    \n            .replace(/\\d{1,2}\\/\\d{1,2}\\/\\d{4}/g, '') \n            .replace(/\\d{1,2}:\\d{2}/g, '')           \n            .replace(/^\\s*[\\r\\n]/gm, '')   \n            .trim();\n    };\n\n    return {\n        json: {\n            \"Date\": data.date || new Date().toLocaleDateString(\"en-US\"),\n            \"Description\": data.description || \"Expense\",\n            \"Amount\": data.amount || \"₱0\",\n            \"Category\": data.category || \"Other\",\n            \"Raw Message\": sanitize(data.raw_message),\n            \"routeYear\": year \n        }\n    };\n});"
      },
